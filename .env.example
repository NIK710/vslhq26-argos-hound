# This root file is a configuration reference only.
# Copy the service-specific examples instead:
#   frontend/.env.example -> frontend/.env
#   backend/.env.example  -> exported shell variables or a local launch profile

# Frontend
VITE_API_BASE_URL=http://localhost:5080

# Backend
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Cors__AllowedOrigins__0=http://localhost:5173
ConnectionStrings__ArgosHound=Data Source=argoshound.db

# AI integration
AzureOpenAI__Endpoint=https://your-resource.openai.azure.com/
AzureOpenAI__DeploymentName=your-deployment-name
AzureOpenAI__ApiKey=replace-with-a-local-secret
Foundry__ProjectEndpoint=https://your-project-endpoint
Foundry__AgentName=argoshound-agent
Foundry__AgentVersion=2
Foundry__RequestTimeoutSeconds=45
Foundry__MaxAttempts=3
